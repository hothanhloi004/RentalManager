<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRoom"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/on_surface"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false"
                app:chipMinHeight="24dp"
                app:chipCornerRadius="12dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                android:layout_margin="0dp"/>
        </LinearLayout>

        <!-- KHACH -->
        <TextView
            android:id="@+id/tvTenant"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- COC VA TIEN -->
        <TextView
            android:text="Ti\u1ec1n c\u1ecdc"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
            
        <TextView
            android:id="@+id/tvDeposit"
            android:layout_marginTop="1dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- DICH VU - HIEN THI THEO HOP DONG -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- WiFi -->
            <LinearLayout
                android:id="@+id/layoutWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/on_surface_variant"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/on_surface_variant"/>
            </LinearLayout>

            <!-- RAC -->
            <LinearLayout
                android:id="@+id/layoutTrash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/on_surface_variant"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R\u00e1c"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/on_surface_variant"/>
            </LinearLayout>

            <!-- PHI DV -->
            <LinearLayout
                android:id="@+id/layoutServiceFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_cleaning"
                    app:tint="@color/on_surface_variant"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ph\u00ed DV"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/on_surface_variant"/>
            </LinearLayout>

        </LinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"/>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="K\u1ebft th\u00fac"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/outline"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditService"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="Sửa dịch vụ"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="8dp"
                android:textColor="@color/primary"
                app:cornerRadius="8dp"/>

            <ImageButton
                android:id="@+id/btnQuickCall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_call"
                app:tint="@color/primary"
                android:contentDescription="Gọi khách thuê"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
